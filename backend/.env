# JobBuddy Backend - Environment Variables

# Application Settings
PROJECT_NAME=JobBuddy
SECRET_KEY=super-secret-key-for-development
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=jobbuddy
POSTGRES_PASSWORD=jobbuddy
POSTGRES_DB=jobbuddy

# Redis
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_BASIC=price_basic_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_UNLIMITED=price_unlimited_placeholder
STRIPE_TRIAL_DAYS_BASIC=7
STRIPE_TRIAL_DAYS_PRO=14
STRIPE_TRIAL_DAYS_UNLIMITED=14
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing
STRIPE_API_VERSION=2023-10-16
STRIPE_TAX_ENABLED=false

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# S3/MinIO Storage (for production)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=jobbuddy-resumes
S3_REGION=us-east-1

# LLM Settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=your-openai-api-key-here
LLM_MIN_CALL_INTERVAL=1.0

# Vector Service Settings
VECTOR_PROVIDER=openai
VECTOR_MODEL=text-embedding-ada-002
VECTOR_API_KEY=your-openai-api-key-here

# OCR Settings
TESSERACT_PATH=/usr/bin/tesseract

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]